generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(cuid())
  firstName          String?
  lastName           String?
  email              String?          @unique
  password           String?
  endpoint           String?
  role               Roles?
  tickets            EventTicket[]
  ticketsAvailable   TicketsAvailable[]
  notifyEvents       Event[]          @relation("UserNotifyEvents")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model EventTicket {
  id                 String           @id @default(cuid())
  name               String?
  passType           String?
  date               String?
  location           String?
  numberOfTickets    Int?
  user               User?            @relation(fields: [userId], references: [id])
  userId             String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model TicketsAvailable {
  id                 String           @id @default(cuid())
  passType           String?
  numberOfTickets    Int              @default(1)
  cost               Int?
  comments           String?
  user               User             @relation(fields: [userId], references: [id])
  userId             String
  event              Event            @relation(fields: [eventId], references: [id])
  eventId            String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Event {
  id                 String           @id @default(cuid())
  name               String?
  category           String?
  date               DateTime?
  location           String?
  ticketsAvailable   TicketsAvailable[]
  notifyUsers        User[]           @relation("UserNotifyEvents")
  ticketType         TicketType[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model TicketType {
  id                 String           @id @default(cuid())
  type               String?
  count              Int?
  event              Event            @relation(fields: [eventId], references: [id])
  eventId            String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

enum Roles {
  Customer
  Admin
}
